# Copy to backend/.env for local development.
APP_URL=http://localhost:5173
AWS_REGION=us-east-1
# DynamoDB Local credentials can be anything, but boto3 needs them set.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_URL=http://localhost:8000
POLLS_TABLE=flashpoll-polls
VOTES_TABLE=flashpoll-votes
CORS_ORIGINS=http://localhost:5173
# In AWS these are set by Terraform: CLIENT_IP_HEADER=CloudFront-Viewer-Address and
# ORIGIN_VERIFY_SECRET=<random>. Leave both unset locally.
